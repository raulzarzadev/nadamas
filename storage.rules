rules_version = '2';

// nadamas Storage security rules
// Uploads go to `${fieldName}/${uuid}` (FirebaseCRUD.uploadFile).
// Files are served via public getDownloadURL() and rendered by next/image,
// and public event pages may show images to anonymous visitors — so READ
// stays public. WRITE is locked to signed-in users with size + type limits.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
