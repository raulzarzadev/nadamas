{
  "compilerOptions": {
    "paths": {
      "@comps/*": [
        "./components/*"
      ],
      "@/*": [
        "./*"
      ],
      "@context": [
        "./context/*"
      ],
      "@utils/*": [
        "./utils/*"
      ],
      "@firebase/*": [
        "./firebase/*"
      ],
      "fb/*": [
        "./firebase/*"
      ],
      "Inputs/*": [
        "./components/Inputs/*"
      ]
    },
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "**/*.ts",
    "**/*.tsx",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "e2e"
  ]
}
