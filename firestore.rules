rules_version = '2';

// nadamas Firestore security rules
// Model: FirebaseCRUD.create() stamps `userId` = creator uid + `createdAt`.
// Baseline: app is auth-gated; owner-only writes; public-flagged content
// readable without auth (public events / entries pages).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // resource for read/update/delete = existing doc; for create = request.resource
    function isOwner(rsc) {
      return signedIn() && rsc.data.userId == request.auth.uid;
    }

    // Admin = roles.admin == true on the caller's own users doc.
    // Tolerates missing `roles`/`admin` via map .get() defaults.
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('roles', {}).get('admin', false) == true;
    }

    // User profiles: any signed-in user can read (profiles shown in app);
    // each user writes only their own doc (doc id == uid).
    match /users/{uid} {
      allow read: if signedIn();
      allow create, delete: if signedIn() && request.auth.uid == uid;
      allow update: if (signedIn() && request.auth.uid == uid) || isAdmin();
    }

    // OTP codes are server-only. API routes use Firebase Admin SDK, which
    // bypasses client rules; app clients should never read or write them.
    match /otpLoginCodes/{id} {
      allow read, write: if false;
    }

    // Public-flagged content: readable by anyone when isPublic == true,
    // otherwise signed-in only. Writes owner-only.
    match /events/{id} {
      allow read: if signedIn() || resource.data.isPublic == true;
      allow create: if isOwner(request.resource);
      allow update, delete: if isOwner(resource);
    }
    match /entries/{id} {
      allow read: if signedIn() || resource.data.isPublic == true;
      allow create: if isOwner(request.resource);
      allow update, delete: if isOwner(resource);
    }

    // Coach profile. Public doc (coaches/{uid}, doc id == uid):
    // any signed-in user may read (athletes browse coaches); only the
    // owner may write. The catch-all below would also match this, but
    // it is declared explicitly for clarity + to anchor the subcollection.
    match /coaches/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == uid;

      // Private verification subdoc (coaches/{uid}/private/profile):
      // IDs, certifications, private contacts, admin notes.
      // Owner has full access; admin may read (verification review).
      // NOT covered by the single-segment catch-all -> explicit rule
      // required, else it is denied by default (this was the bug).
      match /private/{docId} {
        allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
        allow create, delete: if signedIn() && request.auth.uid == uid;
        allow update: if (signedIn() && request.auth.uid == uid) || isAdmin();
      }
    }

    // Owner-scoped domain collections (athletes, atheltes [sic], teams,
    // records, records_V2, results, tests, questions, ...).
    // Any signed-in user may read (coaches view athletes/teams);
    // only the document owner may mutate.
    match /{collection}/{id} {
      allow read: if signedIn();
      allow create: if isOwner(request.resource);
      allow update, delete: if isOwner(resource);
    }

    // NOTE: single-segment wildcard does NOT cover subcollections
    // (e.g. teams/{id}/posts). Those are denied by default until an
    // explicit rule is added. Verify whether any subcollections exist
    // in production before deploying.
  }
}
